var builder = DistributedApplication.CreateBuilder(args);
// 建立模擬的Azure Blob Storage資源
var storage = builder.AddAzureStorage("storage");
// 建立SQL Server資源
var sql = builder.AddSqlServer("sql");
var sqldb = sql.AddDatabase("sqldb");
// 在apiservice專案中，加入對 SQL Server/Azure Blob Storage 的依賴，並且在啟動 apiService 之前，確保 SQL Server/Azure Blob Storage 已經啟動完成
var apiService = builder.AddProject<Projects.KFRoom_ApiService>("apiservice")
    .WithHttpHealthCheck("/health")
    .WaitFor(sqldb)  
    .WithReference(sqldb)
    .WaitFor(storage)
    .WithReference((IResourceBuilder<IResourceWithConnectionString>)storage);
// 這是樣版專案內建
builder.AddProject<Projects.KFRoom_Web>("webfrontend")
    .WithExternalHttpEndpoints()
    .WithHttpHealthCheck("/health")
    .WithReference(apiService)
    .WaitFor(apiService);

builder.Build().Run();
